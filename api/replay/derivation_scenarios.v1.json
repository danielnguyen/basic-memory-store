{
  "schema_version": 1,
  "scenarios": [
    {
      "name": "derived_text_identical_rebuild",
      "derived_class": "derived_text",
      "mode": "validation_only",
      "expected": {"result": "identical", "mutates": false}
    },
    {
      "name": "derived_text_source_changed",
      "derived_class": "derived_text",
      "mode": "persist_replacement",
      "expected": {"result": "replaced", "mutates": true}
    },
    {
      "name": "derived_text_source_missing",
      "derived_class": "derived_text",
      "mode": "validation_only",
      "expected": {"result": "failed", "failure_reason": "source_missing"}
    },
    {
      "name": "proactive_replay_no_delivery_side_effect",
      "derived_class": "proactive_suggestion",
      "mode": "validation_only",
      "expected": {"result": "identical", "mutates": false, "delivery_side_effects": false}
    },
    {
      "name": "proactive_trigger_missing",
      "derived_class": "proactive_suggestion",
      "mode": "validation_only",
      "expected": {"result": "failed", "failure_reason": "source_missing"}
    },
    {
      "name": "memory_item_identical_rebuild",
      "derived_class": "memory_item",
      "mode": "validation_only",
      "expected": {"result": "identical", "mutates": false}
    },
    {
      "name": "memory_item_changed_rebuild_with_supersession",
      "derived_class": "memory_item",
      "mode": "persist_replacement",
      "expected": {"result": "replaced", "mutates": true, "relationship": "supersedes"}
    },
    {
      "name": "episode_identical_rebuild",
      "derived_class": "episode",
      "mode": "validation_only",
      "expected": {"result": "identical", "mutates": false}
    },
    {
      "name": "unsupported_episode_without_recipe",
      "derived_class": "episode",
      "mode": "validation_only",
      "expected": {"result": "unsupported", "reason": "episode lacks a deterministic construction recipe"}
    },
    {
      "name": "cross_owner_rejection",
      "derived_class": "memory_item",
      "mode": "validation_only",
      "expected": {"result": "not_found", "reveals_object": false}
    },
    {
      "name": "injected_persistence_failure",
      "derived_class": "memory_item",
      "mode": "persist_replacement",
      "expected": {"result": "failed", "partial_mutation": false}
    },
    {
      "name": "repeated_request_idempotency",
      "derived_class": "derived_text",
      "mode": "persist_replacement",
      "expected": {"result": "identical", "duplicate_replacements": false}
    }
  ],
  "privacy_banned_fields": [
    "artifact_text",
    "message_content",
    "prompt",
    "summary",
    "body"
  ]
}
